---
import Base from './Base.astro';
import Navigation from '../components/Navigation.astro';
interface Props { title: string; label: string; pageTitle?: string }
const { title, label, pageTitle = title } = Astro.props;
---
<Base title={pageTitle}>
  <header class="page-header">
    <a href="/" class="page-brand" aria-label="ennui ホーム">ennui</a>
    <Navigation />
  </header>
  <main class="page-content"><p class="eyebrow">{label}</p><h1>{title}</h1><slot /></main>
</Base>
