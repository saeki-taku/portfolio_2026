---
import Base from './Base.astro';
interface Props { title: string; label: string }
const { title, label } = Astro.props;
---
<Base title={title}>
  <header class="page-header">
    <a href="/" class="page-brand" aria-label="ennui ホーム">ennui</a>
    <nav aria-label="メインナビゲーション">
      <a href="/works/" aria-current={Astro.url.pathname === '/works/' ? 'page' : undefined}>実績</a>
      <a href="/news/" aria-current={Astro.url.pathname === '/news/' ? 'page' : undefined}>お知らせ</a>
      <a href="/contact/" aria-current={Astro.url.pathname === '/contact/' ? 'page' : undefined}>お問い合わせ</a>
    </nav>
  </header>
  <main class="page-content"><p class="eyebrow">{label}</p><h1>{title}</h1><slot /></main>
</Base>
