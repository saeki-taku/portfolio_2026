<script>
  import { sceneForTokyo } from '../lib/scene-time';
  import { applyScene } from '../lib/scene-display';
  import { resolveScene, slotForScene } from '../lib/scene-catalog';
  import { setupRainMotion } from '../lib/rain-motion';
  // Bounds include the outer window/sill in the shared 1345 × 1170 PC coordinate space.
  const scene = document.querySelector<HTMLElement>('.scene');
  if (scene) {
    const portrait = matchMedia('(max-aspect-ratio: 1/1)');
    const layout = () => {
      const w = document.documentElement.clientWidth;
      const sp = portrait.matches;
      const tallSp = sp && ['spring-dawn-sunny', 'spring-dawn-cloudy', 'spring-dawn-rain', 'spring-day-sunny', 'spring-day-cloudy', 'spring-day-rain', 'summer-dawn-sunny', 'summer-day-sunny', 'summer-evening-sunny', 'summer-night-sunny-awake', 'summer-night-sunny-asleep', 'spring-evening-sunny', 'spring-evening-cloudy', 'spring-evening-rain', 'spring-night-sunny-awake', 'spring-night-cloudy-awake', 'spring-night-rain-awake', 'spring-night-sunny-asleep', 'spring-night-cloudy-asleep', 'spring-night-rain-asleep'].includes(scene.querySelector<HTMLElement>('.mobile-artwork')?.dataset.activeScene ?? '');
      delete scene.dataset.menuPlacement;
      const g = sp
        ? { width: 1024, height: 1997, top: 154, base: 1536, padding: 461, right: 990, bottom: 1530 }
        : { width: 1345, height: 1170, top: 150, base: 756.5625, padding: 413.4375, right: 1305, bottom: 850 };
      // The tall SP paintings include the full outer wall; other scenes retain their existing frame.
      const scale = tallSp ? w / 1024 : Math.min(w / g.width, Math.max(1, w - 20) / g.right);
      if (tallSp) {
        const artworkWidth = 1024 * scale;
        const artworkHeight = 2400 * scale;
        const nav = scene.querySelector<HTMLElement>('.scene-nav')?.getBoundingClientRect();
        // Place the menu after the painting only when its fixed position covers the figure/cup area.
        const menuAfterArt = !!nav && nav.top < 1648 * scale + 16;
        if (menuAfterArt) scene.dataset.menuPlacement = 'after-art';
        scene.style.setProperty('--layout-height', `${Math.ceil(Math.max(document.documentElement.clientHeight, 680, menuAfterArt ? artworkHeight + (nav?.height ?? 0) + 16 : 0))}px`);
        scene.style.setProperty('--layout-width', `${artworkWidth}px`);
        scene.style.setProperty('--layout-image-height', `${artworkHeight}px`);
        scene.style.setProperty('--layout-top', '0px');
        scene.style.setProperty('--layout-logo-top', `${154 * scale + Math.max(16, artworkWidth * .04)}px`);
        return;
      }
      const base = g.base * scale;
      const reveal = (h: number) => Math.min(g.top * scale, Math.max(0, h - base) * g.top / g.padding);
      let h = Math.max(document.documentElement.clientHeight, base, sp ? 680 : 0);
      for (let i = 0; i < 20; i++) {
        h = Math.max(h, (g.bottom - g.top) * scale + reveal(h) + 60);
      }
      const y = reveal(h) - g.top * scale;
      scene.style.setProperty('--layout-height', `${Math.ceil(h)}px`);
      scene.style.setProperty('--layout-width', `${g.width * scale}px`);
      scene.style.setProperty('--layout-image-height', `${g.height * scale}px`);
      scene.style.setProperty('--layout-top', `${y}px`);
      scene.style.setProperty('--layout-logo-top', `${reveal(h) + Math.max(sp ? 16 : 24, g.width * scale * (sp ? .04 : .12))}px`);
    };
    layout();
    window.addEventListener('resize', layout);
    portrait.addEventListener('change', layout);
    const updateClockScene = () => {
      // The preview owns manual selection; the published page has no settings panel.
      if (document.querySelector('.scene-settings')) {
        window.dispatchEvent(new Event('ennui:clock-tick'));
      } else {
        const slot = slotForScene(sceneForTokyo(new Date()));
        applyScene(resolveScene({ season: 'spring', weather: 'sunny', slot }, portrait.matches ? 'sp' : 'pc').displayed, portrait.matches);
      }
      layout();
    };
    const scheduleNextMinute = () => {
      const untilNextMinute = 60_000 - Date.now() % 60_000 + 50;
      window.setTimeout(() => { updateClockScene(); scheduleNextMinute(); }, untilNextMinute);
    };
    updateClockScene();
    scheduleNextMinute();
    portrait.addEventListener('change', updateClockScene);
    window.addEventListener('ennui:scene-request', layout);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) updateClockScene(); });
    window.addEventListener('focus', updateClockScene);
    setupRainMotion();
  }
</script>

<style>
  .pc-artwork {
    position: absolute;
    left: 0;
    top: var(--layout-top, calc(var(--pc-reveal) - var(--pc-top-padding)));
    width: var(--layout-width, var(--pc-render-width));
    height: var(--layout-image-height, calc(var(--pc-render-width) / var(--pc-aspect)));
  }
  .pc-artwork .rain-motion, .mobile-artwork .rain-motion { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  /* Keep the approved hem-cleaned pose intact while seating both feet below the lower window frame. */
  .pc-artwork img[data-scene="spring-day-sunny"][data-layer="rin-pc-hem-cleaned.png"],
  .pc-artwork img[data-scene="spring-day-sunny"][data-layer="pc-contact-shadow-v6.png"] { transform: translateY(1.1965812%); }
  .mobile-artwork img[data-scene="spring-day-sunny"][data-layer="08-rin-notebook.png"] { transform: translateY(0.4583333%); }
  .pc-artwork[data-active-scene^="spring-night-rain"] .rain-motion,
  .mobile-artwork[data-active-scene^="spring-night-rain"] .rain-motion { opacity: .7; }
  .rain-motion[hidden] { display: none; }
  .pc-artwork img { position: absolute; display: block; width: 100%; height: 100%; object-fit: fill; }
  .pc-artwork img[hidden] { display: none; }
  .scene[data-active-scene*="-night-"] .scene-logo { color: #f0eee9; }
  .scene[data-active-scene="spring-dawn-sunny"] .scene-logo { color: #f0eee9; }
  .scene[data-active-scene="spring-dawn-cloudy"] .scene-logo { color: #f0eee9; }
  .scene[data-active-scene="spring-dawn-rain"] .scene-logo { color: #f0eee9; }
  .scene[data-active-scene="summer-dawn-sunny"] .scene-logo { color: #f0eee9; }
  .mobile-artwork { display: none !important; position: absolute; left: 0; top: var(--layout-top, calc(var(--revealed-top) - var(--sp-top-padding))); width: var(--layout-width, 100vw); height: var(--layout-image-height, var(--sp-canvas-height)); }
  .mobile-artwork img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: fill; }
  .mobile-artwork img[hidden] { display: none; }
  @media (max-aspect-ratio: 1/1) {
    .pc-artwork { display: none; }
    .mobile-artwork { display: block !important; }
  }
</style>
