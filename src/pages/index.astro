  const quality = viewport === 'pc' ? 85 : 90;
  const layers = await makeSceneLayers({ width: manifest.width, height: manifest.height, layersBottomToTop: manifest.staticLayersBottomToTop, toggleGroups: groups }, sources, folder, widths, quality);
  const states = Object.entries(manifest.effectStates);
  const filenames = states.flatMap(([, files]) => [files.outdoor, files.droplets]);
  const renderedEffects = await makeSceneLayers({ width: manifest.width, height: manifest.height, layersBottomToTop: filenames, toggleGroups: {} }, sources, folder, widths, quality);
  const effects = renderedEffects.map(layer => {
    const [state, files] = states.find(([, files]) => files.outdoor === layer.filename || files.droplets === layer.filename)!;
    return { ...layer, effect: files.outdoor === layer.filename ? 'outdoor' : 'glass', rin: groups.rin?.length && !state.includes('rin-off') ? 'on' : 'off', plant: state.includes('plant-off') ? 'off' : 'on' };
  });
  return { id: config.id, layers, effects };
}));
