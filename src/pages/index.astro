  const cleanCup = (pcCupCleanupManifest as Record<string, { filename: string }>)[folder];
  let filenames = [...manifest.layersBottomToTop, ...['seat-v9-cup-off-rin-on.png', 'seat-v9-cup-off-rin-off.png', 'seat-v9-cup-off-absent.png'].filter(filename => pcSeatV9RolloutSources[`../assets/validation/pc-seat-v9-rollout/${folder}/${filename}`])]
    .flatMap(filename => filename === '02-interior.png' && pcSeatV9RolloutSources[`../assets/validation/pc-seat-v9-rollout/${folder}/02c-seat-v9-structure.png`] ? [filename, '02c-seat-v9-structure.png'] : [filename])
    .filter(filename => !filename.includes('{'));
  if (cleanCup) {
    // Use the tested cup-free seat/person restoration as the common backing.
    // Otherwise the old ceramic cup shows through the corrected handle hole.
    filenames = filenames.filter(filename => !['02a-cup-body-contact.png', '02b-cup-contact-shadow.png', '03a-rin-cup-on-restore.png', '05-cup-foreground.png'].includes(filename));
    if (manifest.layersBottomToTop.includes('02b-cup-contact-shadow.png')) filenames.push('02b-cup-contact-shadow.png');
    filenames.push('05-cup-clean.png');
  }
  return Promise.all(filenames.map(async filename => {
    const versionKey = `${folder}/${filename === '02c-seat-v9-structure.png' ? '02c-seat-v9-structure-final.png' : filename}`;
    const versionedFilename = (pcSeatV9Versions as Record<string, string>)[versionKey];
    const source = (filename === '05-cup-clean.png' ? pcCupCleanupSources[`../assets/validation/pc-cup-edge-cleanup-v1/${folder}/${cleanCup.filename}`]?.default : undefined)
      ?? pcSeatV9RolloutSources[`../assets/validation/pc-seat-v9-rollout/${folder}/${versionedFilename}`]?.default
      ?? (filename === '02c-seat-v9-structure.png' ? pcSeatV9RolloutSources[`../assets/validation/pc-seat-v9-rollout/${folder}/02c-seat-v9-structure-final.png`]?.default : undefined)
      ?? pcSeatV9RolloutSources[`../assets/validation/pc-seat-v9-rollout/${folder}/${filename}`]?.default
      ?? sources[`../assets/validation/${folder}/${filename}`]?.default;
